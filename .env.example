# ─────────────────────────────────────────────────────────────── required ──
# The only two variables the app cannot start without.

DATABASE_URL="postgresql://voice2brd:voice2brd@localhost:5432/voice2brd?schema=public"
APP_URL="http://localhost:3000"

# ───────────────────────────────────────────────────── strongly recommended ──
# 32 random bytes, base64. Encrypts OAuth tokens and BYOK API keys at rest
# (SPEC-002 §4, SPEC-004 §4). Without it, secrets cannot be stored — the app
# still runs, but the credentials page disables saving.
#   openssl rand -base64 32
APP_ENCRYPTION_KEY=""

# ───────────────────────────────────────────────────────────── behaviour ──
# mock (default) → executions are simulated, nothing leaves the machine.
# live           → executions reach real third-party accounts.
# An unconfigured checkout must never be one click away from emailing a stranger,
# so `mock` is the default deliberately.
INTEGRATIONS_MODE="mock"
# Force specific providers live inside an otherwise-mock process:
INTEGRATIONS_LIVE=""

# true → the environment wins over user-supplied keys (SPEC-004 §3).
CREDENTIALS_ENV_LOCKED="false"

LOG_LEVEL="info"

# The public marketing site. Set it and the app shows a "Visit the website" link in
# the sidebar — a plain cross-origin anchor, so it never touches the session and
# coming back lands you still signed in. Unset ⇒ the link is hidden.
NEXT_PUBLIC_MARKETING_URL="http://localhost:3001"
# Where the FastAPI backend lives. The browser talks to it directly, so this is
# public by necessity — it is an origin, not a secret.
NEXT_PUBLIC_API_URL="http://localhost:8000"
# Server-to-server calls from a React Server Component (SPEC-015 §7) use this instead
# of NEXT_PUBLIC_API_URL — inside Docker Compose the two differ, since `web`'s own
# "localhost" cannot reach the `api` container. Falls back to NEXT_PUBLIC_API_URL when
# unset, which is correct outside Docker (e.g. `npm run dev` against a local `api`).
INTERNAL_API_URL="http://localhost:8000"
# Must equal the FastAPI backend's JWT_SECRET/JWT_ALGORITHM (apps/api/.env.example):
# a Server Component mints its own short-lived bearer token for the backend, and it
# has to verify against the same secret. Never a placeholder in a real deployment.
JWT_SECRET="dev-jwt-secret-change-for-anything-beyond-local-use"
JWT_ALGORITHM="HS256"
DEV_USER_EMAIL="demo@voice2brd.test"
# Accept the single-user dev identity in production deliberately. Without this,
# a production build with no auth provider fails closed rather than serving one
# user's data to everyone.
# ALLOW_DEV_IDENTITY=1
# The seeded demo account's real password (prisma/seed.mjs) — FastAPI has no dev-identity
# bypass (apps/api/app/api/dependencies.py is explicit about why), so logging in as this
# account through the FastAPI backend, e.g. from scripts/smoke.sh, needs a real password.
# DEV_USER_PASSWORD="voice2brd-dev-account-password"

# ══════════════════════════════════════════════════════════════════════════
# Everything below is OPTIONAL. Any key left blank can instead be added per
# user, encrypted, from /dashboard/settings/credentials (SPEC-004).
# ══════════════════════════════════════════════════════════════════════════

# ── OAuth apps (per-user consent flows) ──────────────────────────────────
GOOGLE_CLIENT_ID=""          # Calendar + Gmail. https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_SECRET=""
NOTION_CLIENT_ID=""          # https://www.notion.so/my-integrations
NOTION_CLIENT_SECRET=""
SLACK_CLIENT_ID=""           # https://api.slack.com/apps
SLACK_CLIENT_SECRET=""

# ── Transcription ────────────────────────────────────────── free first ──
GROQ_API_KEY=""              # FREE  ~28,800 audio-sec/day · console.groq.com/keys
ASSEMBLYAI_API_KEY=""        # $50 credit · assemblyai.com
DEEPGRAM_API_KEY=""          # $200 credit · console.deepgram.com
ELEVENLABS_API_KEY=""        # free tier · elevenlabs.io
OPENAI_API_KEY=""            # PAID  whisper-1 / gpt-4o-transcribe
# Local WhisperX needs no key — it runs in the asr service.

# ── Live transcription for the voice surface (SPEC-014 §3) ────────────────
# The voice-to-BRD screen needs a *streaming* provider; the keys above are
# file-upload APIs and cannot serve it. Unconfigured, the record button says so
# rather than falling back to something that looks live but is not.
#
#   auto          first available provider, self-hosted preferred
#   deepgram      uses DEEPGRAM_API_KEY above; the browser gets a 60s scoped token
#   whisper_live  a WhisperLive-compatible service you run; needs SPEECH_WS_URL
SPEECH_PROVIDER="auto"
SPEECH_WS_URL=""             # e.g. ws://asr:9090/ws — self-hosted only, no key needed

# ── Action extraction (LLM) ──────────────────────────────── free first ──
GOOGLE_GEMINI_API_KEY=""     # FREE  1,500 req/day · aistudio.google.com/apikey
CEREBRAS_API_KEY=""          # FREE  1M tokens/day · cloud.cerebras.ai
OPENROUTER_API_KEY=""        # FREE  models with a :free suffix · openrouter.ai/keys
MISTRAL_API_KEY=""           # free experiment tier · console.mistral.ai
TOGETHER_API_KEY=""          # $1 credit · api.together.xyz
COHERE_API_KEY=""            # free trial key · dashboard.cohere.com
HUGGINGFACE_API_KEY=""       # free serverless credits · huggingface.co/settings/tokens
ANTHROPIC_API_KEY=""         # PAID  console.anthropic.com
DEEPSEEK_API_KEY=""          # PAID  very low cost
XAI_API_KEY=""               # PAID  console.x.ai
AZURE_OPENAI_API_KEY=""      # PAID  also needs AZURE_OPENAI_ENDPOINT + _DEPLOYMENT
# OLLAMA_BASE_URL="http://localhost:11434"   # fully local, no key

# ── Translation ──────────────────────────────────────────────────────────
DEEPL_API_KEY=""             # FREE  500k chars/month · deepl.com/pro-api
GOOGLE_TRANSLATE_API_KEY=""  # 500k chars/month free
# LIBRETRANSLATE_URL=""      # self-hosted, no key

# ── Embeddings / semantic search ─────────────────────────────────────────
VOYAGE_API_KEY=""            # FREE  200M tokens · dash.voyageai.com
JINA_API_KEY=""              # FREE  1M tokens · jina.ai/embeddings

# ── Integration API keys (alternative to OAuth) ──────────────────────────
NOTION_API_KEY=""            # internal integration token
NOTION_TASK_DATABASE_ID=""   # target database for created tasks
SLACK_BOT_TOKEN=""           # xoxb-…
SENDGRID_API_KEY=""          # 100 emails/day free
